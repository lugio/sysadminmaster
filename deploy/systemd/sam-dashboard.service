# SysAdminMaster — dashboard (web interface, TCP 5050)
# Install: see docs/installation.md
[Unit]
Description=SysAdminMaster dashboard
After=network-online.target sam-agentmaster.service
Wants=network-online.target

[Service]
Type=simple
User=sam
Group=sam
WorkingDirectory=/opt/sysadminmaster
EnvironmentFile=/opt/sysadminmaster/.env
ExecStart=/opt/sysadminmaster/.venv-linux/bin/python Web/app.py
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sysadminmaster
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
