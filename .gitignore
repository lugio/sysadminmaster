# Environnements Python
.venv/
.venv-linux/
Temp/
**/python_portable/
__pycache__/
*.pyc

# Logs & runtime
*.log
*.log.*          # logs rotatés (agentmaster.log.1, .2…) — non couverts par *.log
Logs/
Scripts/Logs/
Web/*.log

# Dépendances e2e (Playwright, déclarées dans package.json)
node_modules/
e2e/results/
e2e/screenshots/

# Base de données locale (recréée au démarrage)
*.db
sysadminmaster.db

# OS / éditeur
.DS_Store
Thumbs.db

# Secrets runtime — .env seul ne couvre pas .env.dev/.env.prod/.env.local
.env
.env.*
!.env.example

# Config runtime (tokens) — versionner Config/config.example.json à la place
Config/config.json

# État de l'alerte quotidienne licences (runtime)
AgentMaster/.alert-state.json
