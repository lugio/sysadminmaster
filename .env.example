# SysAdminMaster - environment variables
# Copy to `.env` (never commit `.env`) and fill in. Both services (AgentMaster and Dashboard) read it.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Required -------------------------------------------------------------------------------
# Flask session secret (Dashboard)
SAM_SECRET_KEY=CHANGE_ME
# Dashboard admin password (interim login gate; put an SSO reverse proxy in front for production)
SAM_ADMIN_PASSWORD=CHANGE_ME
# Shared secret between the agents and the master (header X-Agent-Token)
SAM_AGENT_TOKEN=CHANGE_ME
# Dashboard -> master secret (header X-Master-Token). It can QUEUE COMMANDS on every host: keep it on the dashboard only.
SAM_MASTER_TOKEN=CHANGE_ME

# --- Master location ------------------------------------------------------------------------
# URL of the AgentMaster as seen by the Dashboard (same machine by default)
SAM_MASTER_URL=http://127.0.0.1:5000

# --- Optional -------------------------------------------------------------------------------
# Read-only token (header X-Read-Token): GET agents/history/alerts/licenses only, never a command.
# For monitoring panels and third-party tools. Must differ from SAM_MASTER_TOKEN. Empty = disabled.
SAM_READ_TOKEN=
# Previous agent token, accepted ONLY during a rotation window (remove once every agent has migrated)
# SAM_AGENT_TOKEN_LEGACY=

# Short host name of the broker agent (the host that carries the profile disk and orchestrates the others).
# Empty = derived from Config/config.json -> RDSServers.ConnectionBroker, then RDS-BROKER.
# SAM_BROKER_HOST=RDS-BROKER

# Public URL of the Dashboard, used for links in alert e-mails. Empty = no link.
# SAM_DASHBOARD_URL=https://sam.example.com

# Daily Office 365 token alert (sent through Mailjet). Empty SAM_ALERT_TO or SAM_ALERT_FROM = alerts disabled.
# SAM_ALERT_TO=it-team@example.com
# SAM_ALERT_FROM=sam@example.com
# MAILJET_API_KEY=
# MAILJET_API_SECRET=

# Office 365 scope: only accounts whose AD distinguishedName contains this OU are alerted. Empty = no filter.
# SAM_O365_SCOPE_OU=OU=Office365,DC=contoso,DC=local
# Accounts whose distinguishedName contains this value are excluded (e.g. an OU of disabled accounts).
# SAM_O365_SCOPE_EXCLUDE=OU=Disabled
# Site-specific technical accounts ignored for Office tokens (comma-separated, added to the built-in Windows accounts).
# SAM_O365_IGNORED_ACCOUNTS=svc-backup,svc-scan
